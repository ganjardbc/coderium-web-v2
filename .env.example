# Coderium V2 - production secrets (template)
# Copy file ini ke `.env` dan isi nilainya. JANGAN commit file .env.
#
#   cp .env.example .env

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=coderium

# API
DATABASE_URL=postgresql://postgres:change_me_postgres_password@postgres:5432/coderium?schema=public
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=7d
